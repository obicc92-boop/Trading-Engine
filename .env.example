# ---------------------------------------------------------------------------------------
# Helm configuration
#
# Trading RULES are not here. The coins, the 200-day rule, the sizing and the halt all live
# in helm/doctrine.py and are not reachable from the environment — so no amount of config
# can change what is traded or loosen a limit. This file only sets operational things:
# which venue, which credentials, how often to wake up.
# ---------------------------------------------------------------------------------------

# --- execution posture -------------------------------------------------------------------
# dry  = identical code path, simulated fills. This is the default and where you start.
# live = real orders, real money.
HELM_MODE=dry

# The second switch. BOTH this and HELM_MODE=live are required before a single real order
# is sent. Failing closed is intentional: one of these you have to type out on purpose.
I_UNDERSTAND_REAL_MONEY=false

# --- venue -------------------------------------------------------------------------------
# binance   spot crypto, 24/7 — the default; the doctrine's coins are Binance EUR pairs
# synthetic generated prices for a demo; never trades anything real
# The account is funded and measured in EUR: the doctrine fixes BTC, ETH, SOL and XRP
# against the euro, so there is no quote currency to choose.
HELM_VENUE=binance

# Starting capital, used for the return figure and as a floor before the first balance sync.
HELM_STARTING_EQUITY=100

# --- credentials -------------------------------------------------------------------------
# Binance: create a key with SPOT TRADING enabled and WITHDRAWALS DISABLED. Restrict it to
# your server's IP. The engine has no code path that can withdraw, but a key that cannot
# withdraw is safe even if the whole box is compromised.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# --- notifications -----------------------------------------------------------------------
# Talk to @BotFather on Telegram to create a bot and get the token.
# Get your chat id from @userinfobot (it is your own numeric user id for a private chat).
# Leave these blank and the engine simply runs silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only this Telegram user id may send commands. Defaults to TELEGRAM_CHAT_ID, which is
# already correct for a private chat. Set it explicitly if the bot lives in a group.
TELEGRAM_ALLOWED_USER_ID=

# Set false for alerts only, with no remote control at all.
TELEGRAM_COMMANDS=true

# --- loop --------------------------------------------------------------------------------
# The rule acts once a day; the loop runs every minute to watch the account, keep the
# dashboard live and catch the daily close as soon as it is published.
HELM_CYCLE_SECONDS=60
HELM_TAKER_FEE=0.001       # used by the dry-run fill simulation only

# --- dashboard ---------------------------------------------------------------------------
PORT=8000
# Set this to anything non-empty and the dashboard and API require it. Leave it empty and
# the guard waves everything through — fine on a laptop, an open liquidate button on
# anything with a domain. Live mode refuses to start without it and runs dry instead.
HELM_UI_TOKEN=

# --- storage -----------------------------------------------------------------------------
# MUST be on a persistent volume in production. This database is the record of which coins
# the rule bought. Lose it and the coins survive on the exchange with nothing managing them:
# the rule will not sell what it has no record of. The engine detects that case and alerts
# loudly, but prevention is the volume. A version-1 database is refused; give v2 a new file.
#
# On Railway: create a volume mounted at /data, then set HELM_DB=/data/helm.db
HELM_DB=data/helm.db
LOG_LEVEL=INFO
