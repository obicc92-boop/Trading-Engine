# ---------------------------------------------------------------------------------------
# Helm configuration
#
# Trading RULES are not here. Risk limits, position sizing, entry and exit logic all live
# in helm/doctrine.py and are not reachable from the environment — so no amount of config
# can loosen a risk limit. This file only sets operational things: which venue, which
# credentials, how often to wake up.
# ---------------------------------------------------------------------------------------

# --- execution posture -------------------------------------------------------------------
# dry  = identical code path, simulated fills. This is the default and where you start.
# live = real orders, real money.
HELM_MODE=dry

# The second switch. BOTH this and HELM_MODE=live are required before a single real order
# is sent. Failing closed is intentional: one of these you have to type out on purpose.
I_UNDERSTAND_REAL_MONEY=false

# --- venue -------------------------------------------------------------------------------
# binance   spot crypto, 24/7 — the default, and the only one that works well at 100 EUR
# alpaca    US equities with fractional shares (market hours only)
# synthetic generated prices for a demo; never trades anything real
HELM_VENUE=binance

# The currency you fund and measure in. Must be a currency the venue actually quotes:
# Binance has EUR pairs (BTCEUR); use USDT/USDC if your account is funded that way.
HELM_QUOTE=EUR

# Starting capital, used for the return figure and as a floor before the first balance sync.
HELM_STARTING_EQUITY=100

# --- credentials -------------------------------------------------------------------------
# Binance: create a key with SPOT TRADING enabled and WITHDRAWALS DISABLED. Restrict it to
# your server's IP. The engine has no code path that can withdraw, but a key that cannot
# withdraw is safe even if the whole box is compromised.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# Alpaca (only if HELM_VENUE=alpaca)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- the decision layer ------------------------------------------------------------------
# Without this key every candidate is declined and nothing is ever bought. That is the
# intended failure mode, not a bug.
ANTHROPIC_API_KEY=
HELM_MODEL=claude-opus-5
HELM_MODEL_EFFORT=high

# --- universe ----------------------------------------------------------------------------
# Empty = rank the venue's own liquid symbols each scan. Pinning a list is recommended
# while you are still watching it closely.
# HELM_SYMBOLS=BTCEUR,ETHEUR,SOLEUR

# --- loop --------------------------------------------------------------------------------
HELM_CYCLE_SECONDS=60      # how often to check open positions
HELM_SCAN_EVERY=5          # scan the market every N cycles (candles don't move that fast)
HELM_TAKER_FEE=0.001       # used by the dry-run fill simulation only

# --- dashboard ---------------------------------------------------------------------------
PORT=8000
# Set this to anything non-empty and the dashboard and API require it. Do this before
# exposing the engine to the internet — the control endpoints can sell your positions.
HELM_UI_TOKEN=

# --- storage -----------------------------------------------------------------------------
# Put this on a persistent volume. Losing it means losing the record of open positions,
# and the engine rebuilds from the exchange but loses every stop and thesis it was managing.
HELM_DB=data/helm.db
LOG_LEVEL=INFO
